{
  "name": "vocalshield-infrastructure",
  "version": "1.0.0",
  "description": "AWS Infrastructure Foundation for VocalShield - Real-time conversation firewall",
  "main": "lib/vocalshield-stack.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:properties": "jest --testPathPattern=tests/properties",
    "test:integration": "jest --testPathPattern=tests/integration",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "deploy:dev": "cdk deploy -c environment=dev",
    "deploy:staging": "cdk deploy -c environment=staging",
    "deploy:production": "cdk deploy -c environment=production",
    "diff": "cdk diff",
    "destroy": "cdk destroy"
  },
  "keywords": [
    "aws",
    "cdk",
    "infrastructure",
    "vocalshield",
    "fraud-detection"
  ],
  "author": "VocalShield Team",
  "license": "MIT",
  "devDependencies": {
    "@aws-sdk/client-cloudwatch": "^3.990.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.990.0",
    "@aws-sdk/client-dynamodb": "^3.990.0",
    "@aws-sdk/client-eventbridge": "^3.990.0",
    "@aws-sdk/client-secrets-manager": "^3.990.0",
    "@aws-sdk/client-sns": "^3.990.0",
    "@aws-sdk/client-ssm": "^3.990.0",
    "@aws-sdk/client-transcribe-streaming": "^3.990.0",
    "@aws-sdk/lib-dynamodb": "^3.990.0",
    "@types/aws-lambda": "^8.10.160",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@types/ws": "^8.5.10",
    "aws-cdk": "^2.133.0",
    "aws-xray-sdk-core": "^3.12.0",
    "fast-check": "^3.15.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "ws": "^8.16.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.133.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  }
}
