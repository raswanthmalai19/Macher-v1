# AWS Configuration
AWS_REGION=us-east-1

# Bedrock Configuration
BEDROCK_AGENT_ID=your-agent-id-here
BEDROCK_AGENT_ALIAS_ID=your-agent-alias-id-here
GUARDRAIL_ID=your-guardrail-id-here
